{
  "name": "w3c-xml-validator",
  "version": "2.0.0",
  "description": "A library for programmatically submitting XML for online validation using W3C's Markup Validation Service (https://validator.w3.org).",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "bin": {
    "w3c-xml-validator": "./bin/cli.js"
  },
  "scripts": {
    "deps:bump": "npx --yes npm-check-updates --enginesNode --interactive --removeRange",
    "test": "eslint . && npx cucumber-js --config cucumber.config.js",
    "lint": "eslint --fix .",
    "ci-workflow": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DPassarelli/w3c-xml-validator"
  },
  "keywords": [
    "w3c",
    "xml",
    "dtd",
    "doctype",
    "validation"
  ],
  "author": "David Passarelli <dpassarelli@camelotcg.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DPassarelli/w3c-xml-validator/issues"
  },
  "homepage": "https://github.com/DPassarelli/w3c-xml-validator#readme",
  "devDependencies": {
    "@cucumber/cucumber": "11.3.0",
    "chai": "6.2.2",
    "eslint": "9.39.2",
    "neostandard": "0.12.2"
  }
}
